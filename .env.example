# Modesy Marketplace - copy to .env.local and fill in real values.
# Never put a real key in this file: it is meant to be committed.

# Project URL, e.g. https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://dxjoxhehsvkqduywivac.supabase.co
# Publishable key (Settings -> API -> "Publishable key"). Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_ZkVlhstfHP3noNJVpo3ZvA_MTVaBpMP
# Secret key (Settings -> API -> "Secret key"). Server-side only: used by
